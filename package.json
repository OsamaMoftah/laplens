{
  "name": "laplens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && next dev --webpack -p 3210",
    "build": "node scripts/copy-ort.mjs && next build --webpack",
    "start": "next start -p 3210",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:space": "node scripts/prepare-space.mjs --clean && LAPLENS_STATIC_EXPORT=1 pnpm build && node scripts/prepare-space.mjs",
    "preview:space": "serve out -l tcp://127.0.0.1:3210 --no-clipboard --no-port-switching",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "onnxruntime-web": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "serve": "^14.2.6",
    "typescript": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22 <25"
  },
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "compression": "1.8.2"
    }
  }
}
